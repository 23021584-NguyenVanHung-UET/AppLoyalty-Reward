{% assign root_path = routes.root_url | append: '/' | replace: '//', '/' %}
{% if product %}
  <lp-estimate data-proxy="{{ root_path | append: 'apps/loyalty' | escape }}" data-css="{{ 'loyalty-widget.css' | asset_url | escape }}" {{ block.shopify_attributes }}>
    <script type="application/json">
      {
        "locale": {{ request.locale.iso_code | json }},
        "currency": {{ cart.currency.iso_code | default: shop.currency | json }},
        "designMode": {{ request.design_mode | json }},
        "appearance": {
          "style": {{ block.settings.estimate_style | json }},
          "icon": {{ block.settings.estimate_icon | json }},
          "accent": {{ block.settings.accent_color | json }},
          "customColors": {{ block.settings.custom_colors | json }},
          "background": {{ block.settings.background_color | json }},
          "foreground": {{ block.settings.foreground_color | json }},
          "heading": {{ block.settings.heading | json | replace: '<', '\u003c' }},
          "showHelp": {{ block.settings.show_help | json }},
          "helpText": {{ block.settings.help_text | json | replace: '<', '\u003c' }},
          "fontSize": {{ block.settings.font_size | json }},
          "padding": {{ block.settings.padding | json }},
          "radius": {{ block.settings.radius | json }},
          "marginTop": {{ block.settings.margin_top | json }},
          "marginBottom": {{ block.settings.margin_bottom | json }}
        },
        "variantId": {{ product.selected_or_first_available_variant.id | json }},
        "variants": [{% for variant in product.variants %}{"id":{{ variant.id | json }},"price":{{ variant.price | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}],
        "strings": {% render 'loyalty-strings' %}
      }
    </script>
  </lp-estimate>
  <script type="module" src="{{ 'loyalty-widget.js' | asset_url }}"></script>
{% endif %}
{% schema %}
{
  "name": "t:settings.estimate",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {"type":"select","id":"estimate_style","label":"t:settings.estimate_style","default":"card","options":[
      {"value":"card","label":"t:settings.estimate_card"},
      {"value":"pill","label":"t:settings.estimate_pill"},
      {"value":"text","label":"t:settings.estimate_text"}
    ]},
    {"type":"select","id":"estimate_icon","label":"t:settings.estimate_icon","default":"gift","options":[
      {"value":"gift","label":"t:settings.estimate_gift"},
      {"value":"star","label":"t:settings.estimate_star"},
      {"value":"none","label":"t:settings.estimate_none"}
    ]},
    {"type":"color","id":"accent_color","label":"t:settings.estimate_accent","default":"#5b37d4"},
    {"type":"checkbox","id":"custom_colors","label":"t:settings.estimate_custom_colors","info":"t:settings.estimate_colors_help","default":false},
    {"type":"color","id":"background_color","label":"t:settings.estimate_background","default":"#f6f2ff"},
    {"type":"color","id":"foreground_color","label":"t:settings.estimate_foreground","default":"#2d204e"},
    {"type":"text","id":"heading","label":"t:settings.estimate_heading","info":"t:settings.label_help"},
    {"type":"checkbox","id":"show_help","label":"t:settings.estimate_show_help","default":true},
    {"type":"textarea","id":"help_text","label":"t:settings.estimate_help_text","info":"t:settings.label_help"},
    {"type":"range","id":"font_size","label":"t:settings.estimate_font_size","min":12,"max":22,"step":1,"unit":"px","default":15},
    {"type":"range","id":"padding","label":"t:settings.estimate_padding","min":8,"max":24,"step":2,"unit":"px","default":16},
    {"type":"range","id":"radius","label":"t:settings.radius","min":0,"max":24,"step":2,"unit":"px","default":16},
    {"type":"range","id":"margin_top","label":"t:settings.estimate_margin_top","min":0,"max":32,"step":4,"unit":"px","default":8},
    {"type":"range","id":"margin_bottom","label":"t:settings.estimate_margin_bottom","min":0,"max":32,"step":4,"unit":"px","default":8}
  ]
}
{% endschema %}
